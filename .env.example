# npm run setup creates .env from this template and replaces the secret/password.
# Existing .env files are preserved; choose your own values if copying manually.
DATABASE_URL="file:./dev.db"
# Netlify: replace DATABASE_URL privately with your Atlas MongoDB connection URL.
# Never commit .env or use NEXT_PUBLIC_ for database credentials.
AUTH_SECRET="replace-with-a-unique-random-secret-of-at-least-32-characters"
ADMIN_EMAIL="admin@veloura.com"
ADMIN_PASSWORD="replace-with-a-unique-admin-password"

# Direct UPI: receives money in your own UPI app; store verifies each bank credit.
UPI_ENABLED="false"
UPI_ID=""
UPI_PAYEE_NAME=""
# Optional Razorpay gateway. Never use NEXT_PUBLIC_ for either secret.
RAZORPAY_ENABLED="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Public admin access for showcasing only; disable and rotate the password before real use.
ADMIN_SHOWCASE_LOGIN="false"
