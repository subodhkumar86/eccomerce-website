# Copy to .env.production, set real values, and keep that file private.
SITE_URL=https://shop.your-domain.com
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/ecco?retryWrites=true&w=majority
AUTH_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace-with-a-unique-password
SUPPORT_EMAIL=care@your-domain.com
STORE_NAME=Veloura
PORT=3000
UPI_ENABLED=false
UPI_ID=
UPI_PAYEE_NAME=
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public admin access for showcasing only; disable and rotate the password before real use.
ADMIN_SHOWCASE_LOGIN="false"
