{
  "name": "veloura-commerce",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate.cjs && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "db:generate": "node scripts/generate.cjs",
    "db:push": "node scripts/db-push.cjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "node scripts/prisma.cjs studio",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:admin": "node tests/admin-integration.cjs",
    "setup": "node scripts/setup.cjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:browser": "node tests/run-browser.cjs",
    "check:production": "node scripts/check-production.cjs",
    "db:mongo:push": "node scripts/mongodb-init.cjs",
    "db:migrate:mongo": "node scripts/migrate-mongodb.cjs",
    "deploy:netlify": "npx --yes netlify-cli@27.13.0 deploy --build --prod",
    "db:mongo:admin": "node scripts/bootstrap-mongodb.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^12.23.12",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "prisma": "^6.16.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
